{
  "name": "andbar-scrape",
  "productName": "andbar-scrape",
  "version": "1.0.0",
  "description": "Electron application for andbarscraping",
  "main": "build/andbar.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "ebs-uchimura (https://github.com/ebs-uchimura/)",
    "email": "uchimura@ebisu-do.jp"
  },
  "dependencies": {
    "csv": "^6.4.1",
    "electron-log": "^5.4.3",
    "encoding-japanese": "^2.2.0",
    "iconv-lite": "^0.6.3",
    "log4js": "^6.9.1",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.0.5",
    "@types/node": "^20.16.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.4.0",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "com.ebisudo.andbarscraping",
    "productName": "andbarscraping",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/andbar.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "GPL-3.0"
}
