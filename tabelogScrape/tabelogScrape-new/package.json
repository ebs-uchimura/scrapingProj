{
  "name": "tabelog-scrape-new",
  "productName": "tabelogscrapenew",
  "version": "1.0.0",
  "description": "Electron application for scraping-new",
  "main": "build/tabelognew.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "ebs-uchimura (https://github.com/ebs-uchimura/)",
    "email": "uchimura@ebisu-do.jp"
  },
  "dependencies": {
    "@ghostery/adblocker-puppeteer": "^2.11.3",
    "cross-fetch": "^4.1.0",
    "csv": "^6.3.11",
    "dotenv": "^17.2.0",
    "electron-log": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "electron": "^44.5.1",
    "electron-builder": "^27.0.0-alpha.9",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.ebisudo.tabelognew",
    "productName": "tabelogscrape-new",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/gourmetnew.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "GPL-3.0"
}
