{
  "name": "gourmetscrape",
  "productName": "gourmetscrape",
  "version": "1.2.5",
  "description": "Electron application for scraping",
  "main": "build/tabelog.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "package-win": "tsc && chcp 65001 && electron-packager . --asar=true --overwrite --platform=win32 --arch=ia32 --prune=true --icon=./assets/gourmet.ico --out=release-builds --electronVersion=29.1.1",
    "start": "tsc && chcp 65001 && electron ."
  },
  "keywords": [],
  "author": "ebs-uchimura <uchimura@ebisu-do.jp>",
  "license": "MIT",
  "dependencies": {
    "csv": "^6.3.11",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.6",
    "electron-log": "^5.1.0",
    "encoding-japanese": "^2.2.0",
    "fs": "^0.0.1-security",
    "iconv-lite": "^0.6.3",
    "log4js": "^6.9.1",
    "node-cache": "^5.1.2",
    "path": "^0.12.7",
    "puppeteer": "^24.10.2",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^24.0.3",
    "electron": "^36.5.0",
    "electron-packager": "^17.1.2"
  }
}
