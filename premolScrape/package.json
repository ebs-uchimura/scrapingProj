{
  "name": "premol-scrape",
  "productName": "premolscrape",
  "version": "1.1.0",
  "description": "Electron application for scraping",
  "main": "build/premol.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "ebs-uchimura (https://github.com/ebs-uchimura/)",
    "email": "uchimura@ebisu-do.jp"
  },
  "dependencies": {
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.5.0",
    "electron-log": "^5.1.0",
    "encoding-japanese": "^2.2.0",
    "iconv-lite": "^0.6.3",
    "log4js": "^6.9.1",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^20.8.9",
    "electron": "^44.0.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.ebisudo.premol",
    "productName": "premolscrape",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/beer.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "GPL-3.0"
}
