{
  "name": "google-scrape",
  "productName": "googlescrape",
  "version": "2.1.5",
  "description": "electron app for googlescrape",
  "main": "build/google.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "ebs-uchimura (https://github.com/ebs-uchimura/)",
    "email": "uchimura@ebisu-do.jp"
  },
  "dependencies": {
    "@ghostery/adblocker-puppeteer": "^2.13.3",
    "cross-fetch": "^4.1.0",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.6",
    "electron-log": "^5.1.2",
    "iconv-lite": "^0.6.3",
    "path": "^0.12.7",
    "puppeteer": "^25.8.0"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.0.5",
    "@types/node": "^20.12.7",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.ebisudo.googlescrape",
    "productName": "googlescrape-app",
    "files": [
      "build/**/*",
      "package.json",
      "node_modules/**/*",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/google.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "GPL-3.0"
}
