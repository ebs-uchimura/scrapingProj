{
  "name": "andbarscrape",
  "productName": "andbarscrape",
  "version": "0.3.0",
  "description": "Electron application for barscraping",
  "main": "build/andbar.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "package-win": "tsc && chcp 65001 && electron-packager . --asar --overwrite --platform=win32 --arch=ia32 --prune=true --icon=./assets/andbar.ico --out=release-builds --electronVersion=28.2.0",
    "start": "tsc && chcp 65001 && electron ."
  },
  "keywords": [],
  "author": "ebs-uchimura <uchimura@ebisu-do.jp>",
  "license": "MIT",
  "dependencies": {
    "csv": "^6.4.1",
    "electron-log": "^5.1.0",
    "encoding-japanese": "^2.2.0",
    "iconv-lite": "^0.6.3",
    "log4js": "^6.9.1",
    "puppeteer-core": "^24.14.0"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.0.5",
    "@types/node": "^20.16.5",
    "electron": "^32.0.1",
    "electron-packager": "^17.1.2"
  }
}
