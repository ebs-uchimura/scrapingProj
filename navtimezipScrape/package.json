{
  "name": "navtime-scrape",
  "productName": "navtime-scrape",
  "version": "1.0.0",
  "description": "Electron application for navtime-scrape",
  "main": "build/navtime.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "ebs-uchimura",
    "email": "uchimura@ebisu-do.jp"
  },
  "dependencies": {
    "@ghostery/adblocker-puppeteer": "^2.13.3",
    "cross-fetch": "^4.1.0",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.6",
    "electron-log": "^5.4.3",
    "iconv-lite": "^0.6.3",
    "puppeteer": "^22.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.ebisudo.navtime",
    "productName": "navtime-scrape",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/zipcode.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "GPL-3.0"
}
