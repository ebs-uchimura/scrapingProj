{
  "name": "hosriku-scrape",
  "productName": "hosrikuscrape",
  "version": "0.1.0",
  "description": "Electron application for hosriku scraping",
  "main": "build/hosriku.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "ebs-uchimura",
    "email": "uchimura@ebisu-do.jp"
  },
  "dependencies": {
    "@ghostery/adblocker-puppeteer": "^2.11.3",
    "cross-fetch": "^4.1.0",
    "csv": "^6.3.11",
    "dotenv": "^17.2.0",
    "electron-log": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "puppeteer": "^24.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "com.ebisudo.hosriku",
    "productName": "hosrikuscrape",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/hosriku.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "GPL-3.0"
}
