{
  "name": "hotpepperscrape",
  "productName": "hotpepperscrape",
  "version": "1.0.1",
  "description": "Electron application for hotpepperscrape",
  "main": "build/hotpepper.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "package-win": "npm run build && electron-packager . --asar --overwrite --platform=win32 --arch=ia32 --prune=false --icon=./assets/pepper.ico --out=release-builds",
    "start": "npm run build && electron ."
  },
  "keywords": [],
