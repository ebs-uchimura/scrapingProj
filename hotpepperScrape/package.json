  "license": "MIT",
  "dependencies": {
    "csv": "^6.3.11",
    "dotenv": "^17.2.0",
    "electron-log": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "mysql2": "^3.14.2",
    "puppeteer-core": "^24.12.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "electron": "^36.5.0",
    "electron-packager": "^17.1.2"
  }
}
